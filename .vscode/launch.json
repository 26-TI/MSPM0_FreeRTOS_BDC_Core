{
  "version": "0.2.0",
  "configurations": [
    {
      "cwd": "${workspaceRoot}",
      "type": "cortex-debug",
      "request": "launch",
      "name": "cmsis-dap-debug",
      "servertype": "openocd",
      // 这个是根据主文件名 作为名字 ${workspaceFolderBasename}
      "executable": "build/${workspaceFolderBasename}.elf",
      "runToEntryPoint": "main",
      "configFiles": [
        "${workspaceRoot}/Flash/daplink.cfg"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 20
      }
    },
    {
      "cwd": "${workspaceRoot}",
      "type": "cortex-debug",
      "request": "launch",
      "name": "jlink-debug",
      "servertype": "jlink",
      "interface": "swd",
      "serverpath": "D:\\Toolchain\\Jlink\\JLink_V958\\JLinkGDBServerCL.exe",
      // 这个是根据主文件名 作为名字 ${workspaceFolderBasename}
      "executable": "build/${workspaceFolderBasename}.elf",
      "runToEntryPoint": "main",
      "device": "MSPM0G3519",
      "svdFile": "Flash/MSPM0G351X.svd",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 20,
      },
    },
    {
      // attach：只连接芯片 + 加载符号，不执行 load，因此 F5 不会烧录
      // 前提：芯片里已有用 Flash/JLink_flash.bat 烧进去的、与当前 ELF 匹配的固件
      "cwd": "${workspaceRoot}",
      "type": "cortex-debug",
      "request": "attach",
      "name": "jlink-attach (只调试不烧录)",
      "servertype": "jlink",
      "interface": "swd",
      "serverpath": "D:\\Toolchain\\Jlink\\JLink_V958\\JLinkGDBServerCL.exe",
      "executable": "build/${workspaceFolderBasename}.elf",
      "device": "MSPM0G3519",
      "svdFile": "Flash/MSPM0G351X.svd",
      "postAttachCommands": [
        "monitor halt"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 20,
      },
    }
  ]
}
